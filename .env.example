# Copy file nay thanh .env (khong commit .env that vao git) roi dien gia
# tri that. .env duoc docker-compose tu doc, khong can khai bao gi them.

# Tai khoan dang nhap Airflow webserver (http://localhost:8080)
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Ma hoa Airflow Connections/Variables luu trong metadata DB. Phai la gia
# tri CO DINH, khong doi giua cac lan deploy - neu doi, moi connection da
# ma hoa truoc do se khong giai ma duoc nua. Sinh 1 lan bang:
#   docker run --rm fuzzy-factory-project-airflow python -c \
#     "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME_GENERATE_A_REAL_FERNET_KEY

# Ky session cookie / CSRF cua webserver. Cung phai co dinh - neu doi,
# toan bo session dang dang nhap se bi invalidate. Sinh bang:
#   docker run --rm fuzzy-factory-project-airflow python -c \
#     "import secrets; print(secrets.token_hex(30))"
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET_KEY

# Metadata database rieng cho Airflow (KHONG dung chung voi Postgres
# fuzzyfactory chua data nghiep vu).
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
